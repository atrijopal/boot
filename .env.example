# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Step 1, speech-to-text: auto (deepgram if its key is set: it recognises voices) | deepgram | groq (text only, no speakers)
ASR_PROVIDER=auto

# Speaker labels guessed from the TEXT (only when the provider gives none). Off: measured unreliable. Use deepgram for real, voice-based labels.
SPEAKERS_ENABLED=false

# Step 2, refinement (set REFINE_ENABLED=false to skip this model call)
REFINE_ENABLED=true
REFINE_MODEL=openai/gpt-oss-20b
# Step 3, extraction of decisions, actions, questions, figures, topics, speaker names
EXTRACT_MODEL=openai/gpt-oss-120b
EXTRACT_EFFORT=medium
# Step 3, one model per reader (each model has its own rate limit and daily token cap)
EXTRACT_MODEL_DECISIONS=qwen/qwen3.8-27b
EXTRACT_MODEL_ACTIONS=openai/gpt-oss-120b
EXTRACT_MODEL_ISSUES=qwen/qwen3.8-27b
EXTRACT_MODEL_DETAILS=qwen/qwen3.8-27b
EXTRACT_MODEL_DISCUSSION=qwen/qwen3.8-27b
NAMES_MODEL=openai/gpt-oss-20b

# Step 4, review of the records + summary + topic bullets. decisions,actions | all | none
REVIEW_MODEL=openai/gpt-oss-120b
REVIEW_SCOPE=decisions,actions

# Optional second provider, to use a different big model for any call. Put its prefix before the model name, e.g.
#   EXTRACT_MODEL_ACTIONS=nvidia:mistralai/mistral-large-2-instruct   or   openrouter:qwen/qwen3-235b-a22b:free
# NVIDIA NIM: https://build.nvidia.com   OpenRouter: https://openrouter.ai   (check each site's live model list and limits)
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Failover: a call whose own model is rate limited or down is answered by this one instead (any provider prefix works)
FALLBACK_MODEL=

# Hard limits
MAX_RUN_TOKENS=80000
RUN_TIMEOUT_SECONDS=600
CACHE_ENABLED=false
