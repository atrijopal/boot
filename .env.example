# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# groq (Whisper, no speaker labels) | deepgram (nova-3, speaker labels)
ASR_PROVIDER=groq
# Optional: override the provider's default model
ASR_MODEL=
# Max seconds of audio per Groq request (keeps each upload < 25 MB)
CHUNK_SECONDS=600
CACHE_ENABLED=true

# Candidate questions/proposals/decisions/tasks are labelled by an LLM (llm | off)
CANDIDATE_DETECTOR=llm
LLM_MODEL=openai/gpt-oss-120b

# Phase 2 refinement (small refiner, larger verifier; both on Groq by default)
REFINE_MODEL=openai/gpt-oss-20b
REFINE_REASONING_EFFORT=medium
VERIFY_MODEL=openai/gpt-oss-120b
VERIFY_ENABLED=true
REFINE_USE_SECOND_ASR=true
# Any OpenAI-compatible endpoint (e.g. OpenRouter) can be used by changing this + the key
LLM_BASE_URL=https://api.groq.com/openai/v1
