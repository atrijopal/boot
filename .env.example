# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# groq (Whisper, no speaker labels) | deepgram (nova-3, speaker labels)
ASR_PROVIDER=groq
# Optional: override the provider's default model
ASR_MODEL=
# Max seconds of audio per Groq request (keeps each upload < 25 MB)
CHUNK_SECONDS=600
CACHE_ENABLED=true

# Candidate questions/proposals/decisions/tasks are labelled by an LLM (llm | off)
CANDIDATE_DETECTOR=llm
LLM_MODEL=openai/gpt-oss-120b

# Phase 2 refinement (small refiner, larger verifier; both on Groq by default)
REFINE_MODEL=openai/gpt-oss-20b
REFINE_REASONING_EFFORT=medium
VERIFY_MODEL=openai/gpt-oss-120b
VERIFY_ENABLED=true
REFINE_USE_SECOND_ASR=true
# Optional separate key for a different OpenAI-compatible chat provider.
# Leave blank to reuse GROQ_API_KEY with the default Groq endpoint only.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1

# Phase 3: empty model names inherit LLM_MODEL / VERIFY_MODEL.
PHASE3_MODEL=
PHASE3_VERIFY_MODEL=
PHASE3_EMBEDDING_BACKEND=spacy
PHASE3_TOPIC_THRESHOLD=0.62
PHASE3_MERGE_THRESHOLD=0.92
PHASE3_TEMPERATURE=0.12
PHASE3_BATCH_CHARS=14000
PHASE3_UNIT_CHARS=1200
PHASE3_SUMMARY_WORDS=900
PHASE3_MAX_RELATION_PAIRS=5000
